<sdf version='1.11'>
  <model name='so101_new_calib'>
    <!-- Base-anchored articulated model. The initial joint state comes from
         dataset row 149464 after applying the follower calibration convention. -->
    <static>false</static>
    <!-- Primitive proxies avoid unstable triangle-mesh contact with the table
         and task objects. Global self-contact is disabled because conservative
         boxes overlap at adjacent motor joints; commanded trajectories are
         prechecked instead. -->
    <self_collide>false</self_collide>
