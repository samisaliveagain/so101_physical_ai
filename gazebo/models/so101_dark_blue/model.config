<?xml version="1.0"?>
<model>
  <name>SO-101 Dark Blue with FPV Camera</name>
  <version>1.0</version>
  <sdf version="1.11">model.sdf</sdf>
  <author>
    <name>TheRobotStudio / project adaptation</name>
  </author>
  <description>
    Official SO-101 model adapted with dark-blue printed parts, the dataset
    follower-calibrated observation pose, six-joint trajectory control,
    primitive collision proxies, and a 640x480 robot-mounted FPV camera.
  </description>
</model>
